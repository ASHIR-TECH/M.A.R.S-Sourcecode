          },
          {
            "props": {
              "heading": "HEADING_2",
              "children": [
                {
                  "props": {
                    "text": "Communication Flow",
                    "font": "Arial",
                    "size": 24,
                    "bold": true,
                    "color": "0A0A0A"
                  }
                }
              ],
              "spacing": {
                "before": 260,
                "after": 100
              }
            }
          },
          {
            "props": {
              "children": [
                {
                  "props": {
                    "text": "Every MARS action follows the same three-step path:",
                    "font": "Arial",
                    "size": 20,
                    "color": "4A4A4A"
                  }
                }
              ],
              "spacing": {
                "before": 60,
                "after": 80
              }
            }
          },
          {
            "props": {
              "children": [
                {
                  "props": ""
                }
              ],
              "spacing": {
                "before": 0,
                "after": 60
              }
            }
          },
          {
            "props": {
              "numbering": {
                "reference": "bullets",
                "level": 0
              },
              "children": [
                {
                  "props": {
                    "text": "Phone sends an HTTPS request to the desktop peer's REST API (authenticated with the ADTP API token stored in the device keychain)",
                    "font": "Arial",
                    "size": 20,
                    "color": "4A4A4A"
                  }
                }
              ],
              "spacing": {
                "before": 40,
                "after": 40
              }
            }
          },
          {
            "props": {
              "numbering": {
                "reference": "bullets",
                "level": 0
              },
              "children": [
                {
                  "props": {
                    "text": "Desktop REST API processes the request — if it involves the agent, it calls the embedded agent runtime which may execute one or more tools",
                    "font": "Arial",
                    "size": 20,
                    "color": "4A4A4A"
                  }
                }
              ],
              "spacing": {
                "before": 40,
                "after": 40
              }
            }
          },
          {
            "props": {
              "numbering": {
                "reference": "bullets",
                "level": 0
              },
              "children": [
                {
                  "props": {
                    "text": "Desktop REST API returns a JSON response — MARS renders it",
                    "font": "Arial",
                    "size": 20,
                    "color": "4A4A4A"
                  }
                }
              ],
              "spacing": {
                "before": 40,
                "after": 40
              }
            }
          },
          {
            "props": {
              "children": [
                {
                  "props": ""
                }
              ],
              "spacing": {
                "before": 0,
                "after": 80
              }
            }
          },
          {
            "props": {
              "children": [
                {
                  "props": {
                    "text": "The phone never connects directly to any QUIC peer, never reads any filesystem and never holds any sensitive file data. It is a display and input layer only.",
                    "font": "Arial",
                    "size": 20,
                    "color": "4A4A4A"
                  }
                }
              ],
              "spacing": {
                "before": 60,
                "after": 80
              }
            }
          },
          {
            "props": {
              "children": [
                {
                  "props": ""
                }
              ],
              "spacing": {
                "before": 0,
                "after": 120
              }
            }
          },
          {
            "props": {
              "heading": "HEADING_2",
              "children": [
                {
                  "props": {
                    "text": "Auth Architecture",
                    "font": "Arial",
                    "size": 24,
                    "bold": true,
                    "color": "0A0A0A"
                  }
                }
              ],
              "spacing": {
                "before": 260,
                "after": 100
              }
            }
          },
          {
            "props": {
              "children": [
                {
                  "props": {
                    "text": "OAuth is handled entirely on the phone using Expo Auth Session. After the user authenticates with Google or Apple, MARS receives an identity token. This token is sent to the desktop REST API to exchange for the ADTP API token stored in the desktop peer's keychain. All subsequent requests use the ADTP API token, not the OAuth token.",
                    "font": "Arial",
                    "size": 20,
                    "color": "4A4A4A"
                  }
                }
              ],
              "spacing": {
                "before": 60,
                "after": 80
              }
            }
          },
