                "before": 0,
                "after": 160
              }
            }
          },
          {
            "props": {
              "heading": "HEADING_1",
              "children": [
                {
                  "props": {
                    "text": "Overview",
                    "font": "Arial",
                    "size": 28,
                    "bold": true,
                    "color": "C8430A"
                  }
                }
              ],
              "spacing": {
                "before": 360,
                "after": 160
              },
              "border": {
                "bottom": {
                  "style": "single",
                  "size": 6,
                  "color": "C8430A",
                  "space": 4
                }
              }
            }
          },
          {
            "props": {
              "children": [
                {
                  "props": {
                    "text": "MARS ",
                    "font": "Arial",
                    "size": 20,
                    "bold": true,
                    "italics": false,
                    "color": "C8430A"
                  }
                },
                {
                  "props": {
                    "text": "(Mobile Agent Remote System) is the React Native + Expo mobile companion to the ADTP desktop application. It is a remote control — no agent logic, no QUIC peer, no filesystem access runs on the phone. Every operation the user initiates on MARS is sent to the ADTP desktop peer over HTTPS via the Phase 4 REST API. The desktop peer's embedded agent (Phase 10) executes the work and returns the result. MARS renders it.",
                    "font": "Arial",
                    "size": 20,
                    "bold": false,
                    "italics": false,
                    "color": "4A4A4A"
                  }
                }
              ],
              "spacing": {
                "before": 60,
                "after": 80
              }
            }
          },
          {
            "props": {
              "children": [
                {
                  "props": ""
                }
              ],
              "spacing": {
                "before": 0,
                "after": 80
              }
            }
          },
          {
            "props": {
              "children": [
                {
                  "props": {
                    "text": "The design mandate is simple, refined and maximally optimised — not feature-heavy. The app does a small number of things extremely well: authenticate once, talk to the agent, see what is connected, see what has been transferred.",
                    "font": "Arial",
                    "size": 20,
                    "color": "4A4A4A"
                  }
                }
              ],
              "spacing": {
                "before": 60,
                "after": 80
              }
            }
          },
          {
            "props": {
              "children": [
                {
                  "props": ""
                }
              ],
              "spacing": {
                "before": 0,
                "after": 120
              }
            }
