        "children": [
          {
            "props": {
              "children": [
                {
                  "props": {
                    "text": "MARS — MOBILE AGENT REMOTE SYSTEM",
                    "font": "Arial",
                    "size": 22,
                    "bold": true,
                    "color": "C8430A",
                    "allCaps": true
                  }
                }
              ],
              "spacing": {
                "before": 0,
                "after": 60
              }
            }
          },
          {
            "props": {
              "children": [
                {
                  "props": {
                    "text": "Mobile Command App Build Specification  |  React Native + Expo  |  Ashir Tech — ashir.world",
                    "font": "Arial",
                    "size": 19,
                    "color": "4A4A4A"
                  }
                }
              ],
              "spacing": {
                "before": 0,
