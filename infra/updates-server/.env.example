# Copy to .env and fill in. Everything maps 1:1 to xprem server env vars.
# stateless-mode uses flat env; leaving DB_URL empty keeps it that way.

# --- Public endpoint (expo-updates requires HTTPS on device) ---
DOMAIN=updates.example.com          # your domain, or 127.0.0.1.sslip.io for local tests
ACME_EMAIL=you@example.com          # Let's Encrypt expiry notices (Caddy)
BASE_URL=https://updates.example.com

# --- Server ---
# Generate once and keep stable:  openssl rand -base64 32
JWT_SECRET=change-me
USE_DASHBOARD=true

# --- Dashboard first admin (only read on first boot) ---
ADMIN_EMAIL=admin@example.com
# >= 8 chars, must include uppercase, lowercase, digit and special char
ADMIN_PASSWORD='ChangeMe123!'

# --- Expo access (channel→branch resolution + publish validation) ---
# Create at https://expo.dev/settings/access-tokens
EXPO_ACCESS_TOKEN=your-expo-access-token
EXPO_APP_ID=de93ee69-8f27-4c55-a8d1-ab851751cfbb

# --- Storage (local is fine for a single instance; S3/R2 for multi-node) ---
STORAGE_MODE=local
LOCAL_BUCKET_BASE_PATH=/updates

# --- Manifest signing keys (mounted from ./certs in docker-compose.yml) ---
KEYS_STORAGE_TYPE=local
PUBLIC_LOCAL_EXPO_KEY_PATH=/keys/public-key.pem
PRIVATE_LOCAL_EXPO_KEY_PATH=/keys/private-key.pem

# --- Cache ---
CACHE_MODE=local

# --- Optional: set only when migrating to the DB-backed control plane ---
# DB_URL=postgres://postgres:secret@postgres:5432/expo_ota
# DB_KEYS_MASTER_KEY_B64=change-me