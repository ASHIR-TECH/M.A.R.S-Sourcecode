# Copy to .env and fill in real values. Never commit the real .env.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_AUTH_RELAY_URL=

# Backend relay base URL used for Flutterwave donation verification (Phase 11)
EXPO_PUBLIC_BACKEND_URL=

# Flutterwave merchant public key (FLWPUBK-...). Safe to embed in the app.
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
