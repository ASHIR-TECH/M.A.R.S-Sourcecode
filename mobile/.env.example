# Copy to .env and fill in real values. Never commit the real .env.

# Supabase project (dashboard -> Project Settings -> API).
# Sign-in is handled entirely by Supabase: the app sends the user to the
# provider in the system browser, Supabase exchanges the code server-side and
# hands back a session, and the provider token never touches the device.
#
# The publishable key is designed to be public -- it only grants the `anon`
# role, which Row Level Security then restricts. Never put the `service_role`
# key in here; it bypasses RLS and anything in a mobile bundle is readable by
# anyone who unpacks the APK.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Real, publicly reachable legal pages. Google requires these on a verified
# domain for the OAuth consent screen; the built-in example.com fallback is a
# verification blocker, so replace them before submitting for review.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Backend relay base URL used for Flutterwave donation verification (Phase 11)
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:3001

# Donations are OFF by default. Flutterwave needs a verified merchant account
# before any payment can succeed, so until then the donate button is disabled
# and says so. To enable: finish verification, switch to a live public key,
# then set this to true and rebuild with `npx expo start -c`.
EXPO_PUBLIC_DONATIONS_ENABLED=false

# Flutterwave merchant public key (FLWPUBK-...). Safe to embed in the app.
# Format: FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X  (sandbox/test)
#         FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X       (live)
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Phase 12 fallback (quick-response) chat is proxied by the relay's
# /fallback-chat endpoint, so the Groq key stays in relay/.env — never here.