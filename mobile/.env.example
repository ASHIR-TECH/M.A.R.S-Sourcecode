# Copy to .env and fill in real values. Never commit the real .env.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GITHUB_CLIENT_ID=

# Base URL of the identity service (repo-root/auth-server). All sign-in goes
# through it: the app sends a provider authorization code and receives its own
# short-lived access token plus a rotating refresh token. The provider token
# itself never reaches the device.
#   Android emulator -> host machine: http://10.0.2.2:4000
#   Physical device on LAN:         http://192.168.1.20:4000
#   Deployed:                       https://auth.example.com
EXPO_PUBLIC_AUTH_SERVER_URL=

# Backend relay base URL used for Flutterwave donation verification (Phase 11)
EXPO_PUBLIC_BACKEND_URL=

# Flutterwave merchant public key (FLWPUBK-...). Safe to embed in the app.
# Format: FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X  (sandbox/test)
#         FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X       (live)
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Phase 12 fallback (quick-response) chat is proxied by the relay's
# /fallback-chat endpoint, so the Groq key stays in relay/.env — never here.
