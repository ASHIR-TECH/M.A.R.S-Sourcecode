# Copy to relay/.env and fill in real values. Never commit the real relay/.env.
GITHUB_CLIENT_SECRET=

# Flutterwave server-side secret key (FLWSECK-...). Never commit the real value.
# Format: FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X  (sandbox/test)
#         FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X       (live)
FLUTTERWAVE_SECRET_KEY=

# Webhook secret hash configured in the Flutterwave dashboard.
# Format: the plain string you set as the secret hash under Dashboard > Webhooks
#         (no FLW prefix). Example: mars_sandbox_wh_ab12cd34ef56
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Groq API key for Phase 12 fallback (quick-response) chat. Server-only — the
# mobile app calls this relay's /fallback-chat, never Groq directly.
GROQ_API_KEY=

# Optional: fallback model id (defaults to openai/gpt-oss-120b).
# Other valid ids include: openai/gpt-oss-20b, qwen/qwen3.8-27b, groq/compound-mini
GROQ_MODEL=

# Optional: per-device daily message cap for fallback chat (defaults to 50).
FALLBACK_DAILY_LIMIT=
