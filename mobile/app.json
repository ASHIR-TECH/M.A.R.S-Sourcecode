{
  "expo": {
    "name": "MARS",
    "slug": "ashir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0704",
    "scheme": "mars",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "world.ashir.mars",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "world.ashir.mars",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B0704",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0B0704",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-bg.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#0B0704",
          "dark": {
            "image": "./assets/images/splash-bg.jpg",
            "backgroundColor": "#0B0704"
          },
          "android": {
            "image": "./assets/images/splash-icon-transparent.png",
            "resizeMode": "cover",
            "backgroundColor": "#0B0704",
            "dark": {
              "image": "./assets/images/splash-icon-transparent.png",
              "backgroundColor": "#0B0704"
            }
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mars needs camera access to scan your desktop's pairing code."
        }
      ],
      "expo-web-browser",
      "expo-video",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "24eb31f9-2bf9-4fd9-bba0-bda568d1e080"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "owner": "ashir-techs-team"
  }
}
