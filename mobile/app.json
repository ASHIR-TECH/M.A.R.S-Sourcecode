{
  "expo": {
    "name": "ADTP",
    "slug": "adtp-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080F",
    "scheme": "adtp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "world.ashir.adtp",
      "infoPlist": {
        "NSFaceIDUsageDescription": "ADTP uses Face ID or Touch ID to unlock the app and protect your API token."
      }
    },
    "android": {
      "package": "world.ashir.adtp",
      "adaptiveIcon": {
        "backgroundColor": "#0F0E47",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ADTP uses Face ID or Touch ID to unlock the app and protect your API token."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
