{
  "expo": {
    "name": "MARS",
    "slug": "mars",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0704",
    "scheme": "mars",
    "splash": {
      "image": "./assets/images/splash-bg.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#0B0704"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "world.ashir.mars",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "world.ashir.mars",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B0704",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0B0704",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-bg.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#0B0704",
          "dark": {
            "image": "./assets/images/splash-bg.jpg",
            "backgroundColor": "#0B0704"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mars needs camera access to scan your desktop's pairing code."
        }
      ],
      "expo-web-browser",
      "expo-video",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "cbb39cdf-11ab-46db-b9d0-5acf3d15f186"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "fonts": [],
    "owner": "contractorx"
  }
}
