{
  "expo": {
    "name": "MARS",
    "slug": "mars-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080F",
    "scheme": "mars",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08080F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "world.ashir.mars",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Mars uses Face ID or Touch ID to unlock the app and protect your API token."
      }
    },
    "android": {
      "package": "world.ashir.mars",
      "adaptiveIcon": {
        "backgroundColor": "#0F0E47",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#08080F",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#08080F"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mars uses Face ID or Touch ID to unlock the app and protect your API token."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de93ee69-8f27-4c55-a8d1-ab851751cfbb"
      }
    }
  }
}
