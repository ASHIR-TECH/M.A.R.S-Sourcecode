# ---------------------------------------------------------------------------
# MARS identity service — copy to .env and fill in. Never commit .env.
# Generate a signing secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

HOST=0.0.0.0
PORT=4000

# Number of reverse proxies in front of this service. Keep at 1 when deployed
# behind exactly one proxy/load balancer. Rate limiting keys off req.ip, so a
# wrong value either lets clients spoof X-Forwarded-For or lumps users together.
TRUST_PROXY_HOPS=1

# Public identity of this service. Must match the URLs your provider consoles
# list as allowed redirect targets.
AUTH_ISSUER=https://auth.example.com
AUTH_AUDIENCE=mars-mobile

# Required. At least 32 characters. Rotating this invalidates every access
# token, though refresh tokens survive and will mint new access tokens.
JWT_SECRET=

# Session lifetimes. Access tokens are short-lived and stateless; refresh
# tokens are opaque, hashed at rest, and rotate on every use.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Required. Comma-separated, exact matches only. Sign-ins presenting a
# redirect URI not on this list are rejected before contacting any provider.
# Include every Expo dev/hosted scheme you use, e.g.
#   mars://auth
#   exp://127.0.0.1:8081/--/auth
#   exp://192.168.1.20:8081/--/auth
ALLOWED_REDIRECT_URIS=

# Only needed for browser-based callers (admin dashboard, tooling). Native apps
# send no Origin header. Leave empty to refuse all browser origins.
CORS_ALLOWED_ORIGINS=

DATABASE_PATH=./data/auth.db

# --- Providers (configure only the ones you use) --------------------------
# Each provider's console must list every ALLOWED_REDIRECT_URIS entry.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple's "Services ID" for native apps (not the bundle ID).
APPLE_CLIENT_ID=
